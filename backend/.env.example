LUMO_LOG_PATH=system.log

# Web Push (generate one persistent P-256 VAPID pair per environment)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@luminostech.tech
