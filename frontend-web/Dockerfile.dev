# syntax=docker/dockerfile:1.4
# ─────────────────────────────────────────────────────────────────────────────
# LUMO Hub — Frontend Web development Dockerfile
# ─────────────────────────────────────────────────────────────────────────────
#
# Dùng với docker-compose.dev.yml
# BuildKit cache mount giúp npm ci nhanh hơn ở lần 2+
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
# BuildKit cache mount: persist npm cache giữa các lần build
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
